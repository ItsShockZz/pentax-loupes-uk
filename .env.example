# Copy to `.env` for local development. Never commit `.env`.
# On Vercel, set these under Project → Settings → Environment Variables.

# Shared key that unlocks /manage (the passport manager). Choose something long.
# Locally the dev server falls back to "pentax-dev" when this is unset.
PASSPORT_ADMIN_KEY=choose-a-long-random-key

# Production storage. In Vercel: Storage → Create Database → Upstash for Redis →
# connect it to this project. Vercel injects these two variables automatically.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Email alerts: every new website lead, passport support request, "needs a hand"
# check-in and colleague enquiry is emailed to the UK team. The recipient
# defaults to drpuyanheydari@gmail.com (DEFAULT_NOTIFY_TO in lib/passport/service.js);
# set PASSPORT_NOTIFY_TO to send somewhere else.
# PASSPORT_NOTIFY_TO=
#
# Transport A — a mailbox over SMTP, e.g. a Gmail account (no extra service).
# Needs a Google "App password" (Google Account → Security → 2-Step
# Verification → App passwords); the normal account password will not work.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=drpuyanheydari@gmail.com
# SMTP_PASSWORD=the 16-character app password
# (Port 465 is TLS. Port 587 uses STARTTLS. SMTP_INSECURE=1 allows a plain
#  connection for local testing only. Any other mailbox works the same way.)
#
# Transport B — resend.com, used when no SMTP_HOST is set. This is what
# production uses: the Resend add-on in Vercel (project → Integrations →
# Marketplace → Resend) creates the account and sets RESEND_API_KEY itself.
# The default sender only delivers to the address that owns the Resend account
# until a sending domain is verified there.
# RESEND_API_KEY=
# PASSPORT_NOTIFY_FROM=PENTAX Loupes UK <onboarding@resend.dev>

# Optional: absolute site URL used inside alert emails (defaults to the request host).
# PASSPORT_BASE_URL=https://www.pentaxloupes.co.uk

# CRM hand-off (github.com/ItsShockZz/pentax-crm). Every website enquiry,
# passport support request, "needs a hand" check-in and colleague enquiry is
# posted to the CRM's lead intake as a structured lead, signed with HMAC-SHA256.
# CRM_WEBHOOK_SECRET must be the SAME value as the CRM's INGEST_WEBHOOK_SECRET
# (copy it from the CRM project's environment variables in Vercel).
# The secret may be named either CRM_WEBHOOK_SECRET or WEBSITE_WEBHOOK_SECRET
# (the latter is the CRM's own name for it, so one name can be used in both projects).
# CRM_WEBHOOK_URL=https://pentax-crm.vercel.app/api/ingest/webhook
# CRM_WEBHOOK_SECRET=
